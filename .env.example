# Clave de API de Fal.ai (Obligatoria)
# Obtenla en: https://fal.ai/dashboard/keys
FAL_KEY=

# Puerto del servidor (Render lo asigna dinámicamente)
PORT=3000

# Endpoint de Fal.ai (por defecto: fal-ai/flux-lora-fill)
# Alternativas: fal-ai/flux-pro/v1/fill, fal-ai/flux/dev/inpainting
FAL_MODEL_ENDPOINT=fal-ai/flux-lora-fill
